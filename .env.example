# Runtime configuration. `install_pi-hole.sh` creates this file (mode 600) and
# fills WEBPASSWORD. Do not commit it: it holds the admin password.
#
# These values are read by docker compose, so they apply to manual runs too.

# Timezone for logs and query timestamps. Left blank, the installer copies the
# host's timezone (e.g. America/Sao_Paulo).
TZ=

# Admin password. Leave blank and the installer generates a 24-character one.
WEBPASSWORD=

# Pin a release rather than `latest`, so an upgrade is a deliberate act.
# Tags: https://hub.docker.com/r/pihole/pihole/tags
PIHOLE_VERSION=2026.11.0

# Host ports. Change the DNS port only if 53 is taken by something else.
PIHOLE_DNS_PORT=53
PIHOLE_WEB_PORT=80
PIHOLE_HTTPS_PORT=443

# DHCP server: opt-in, and it also needs docker-compose.dhcp.yml (the installer
# adds it when this is true). Fill in the range and the router address.
PIHOLE_ENABLE_DHCP=false
PIHOLE_DHCP_START=
PIHOLE_DHCP_END=
PIHOLE_DHCP_ROUTER=
